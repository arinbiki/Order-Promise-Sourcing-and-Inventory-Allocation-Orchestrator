# ==============================================================================
# Deterministic Order Promise, Sourcing, and Inventory Allocation Orchestrator
# Configuration Template (.env.example)
# ==============================================================================

# PostgreSQL Blackboard Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/windmill?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=windmill
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Windmill Decision Engine Configuration
WINDMILL_BASE_URL=http://localhost:8080
WINDMILL_API_TOKEN=your_windmill_api_token_here
WINDMILL_WORKSPACE=demo
WINDMILL_SCRIPT_PATH=f/order_scm/appealing_script

# n8n Orchestrator Configuration
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here

# Supply Chain Policy & Optimization Defaults
SPLIT_PENALTY_AMOUNT=25.00
STALE_INVENTORY_MINS=120
HAIRCUT_DISCOUNT_PCT=0.20
CREDIT_HOLD_THRESHOLD=5000.00
DEFAULT_CONFIDENCE_THRESHOLD=0.80
